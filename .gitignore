node_modules/
.turbo/
dist/
*.zip
.DS_Store

# 根目录调试截图（调试产物，不入库）
/*.png

# 本地 MCP / IDE 配置（含调试用浏览器实例地址，不入库）
.opencode/

# Claude 本地开发笔记（私有）
.claude/

# SQLite 数据库（采集数据，含隐私）+ WAL 模式副产物（-wal/-shm 由 better-sqlite3 WAL 产生，运行时生成）
apps/collector-server/*.db
apps/collector-server/*.db-wal
apps/collector-server/*.db-shm

# docker compose 挂载的数据库目录（./data:/data，含真实采集数据，勿入库）
data/

# collector-cli server 运维产物（pid 文件 + 后台日志，本地运行时生成）
apps/collector-server/.collector-server.pid
apps/collector-server/.collector-server.log

# 环境变量（含真实 token，不入库；.env.example 是模板，入库）
.env
.env.*
!.env.example

# Superpowers brainstorm mockups（visual companion 产物，临时）
.superpowers/

# subtitle-extractor:ort wasm 是 copy-ort.mjs 从 @huggingface/transformers 拷贝的构建产物,不入库
apps/subtitle-extractor/public/ort/
youtube-subs/

# Stryker 变异测试与覆盖率产物（reports/、.stryker-tmp/、coverage/、*.lcov，本地生成不入库）
reports/
.stryker-tmp/
coverage/
*.lcov

# 本地 dev server 的内置备份产物（生产备份在 docker volume 内，不在此）
apps/collector-server/backups/
