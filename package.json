{
  "name": "bilibili-extensions",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:server": "pnpm -C apps/collector-server build",
    "build:web": "pnpm -C apps/collector-web build",
    "build:ext": "pnpm -C apps/subtitle-collector build",
    "dev": "turbo dev",
    "dev:server": "pnpm -C apps/collector-server dev",
    "dev:web": "pnpm -C apps/collector-web dev",
    "dev:ext": "pnpm -C apps/subtitle-collector dev",
    "test": "turbo run test",
    "test:ext": "turbo run build --filter=@bilibili-ext/subtitle-collector && node scripts/verify-collector.mjs",
    "test:youtube": "turbo run build --filter=@bilibili-ext/subtitle-collector && node scripts/verify-youtube-collector.mjs",
    "verify:deployed": "node scripts/verify-deployed.mjs",
    "lint:quality": "node scripts/quality-baseline.mjs check",
    "depcruise": "depcruise apps/collector-server/src apps/collector-web/src apps/subtitle-collector/src apps/subtitle-collector/*.mjs apps/subtitle-collector/*.js scripts --config .dependency-cruiser.cjs",
    "qa": "turbo run build --force && turbo run test --force && node --test scripts/quality-baseline.test.mjs scripts/pre-commit-check.test.mjs scripts/verify-skill-sync.test.mjs && pnpm lint:quality && node scripts/verify-skill-sync.mjs && pnpm depcruise && node -e \"console.log('[qa] ✓ 全部质量门通过。覆盖率若显著高于锁定线(>2pp)，请手动上调阈值并 commit（CLAUDE.md 测试质量政策）')\"",
    "prepare": "husky",
    "cli": "pnpm -C apps/collector-server exec tsx src/cli/main.ts",
    "collect-uppers": "pnpm -C apps/collector-server exec tsx ../../scripts/collect-uppers.mts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.0",
    "husky": "^9.1.7",
    "puppeteer": "^23.0.0",
    "turbo": "^2",
    "typescript-eslint": "^8.67.0",
    "ws": "^8.18.0"
  },
  "packageManager": "pnpm@9.15.4"
}
